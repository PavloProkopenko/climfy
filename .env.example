REACT_APP_PORT=3000
VITE_OPENWEATHER_API_KEY=

# Supabase (get from supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend URL (climfy-server)
VITE_API_BASE_URL=http://localhost:3001

# Playwright E2E tests — pre-created Supabase user with onboarding_completed = true
PLAYWRIGHT_TEST_EMAIL=test@example.com
PLAYWRIGHT_TEST_PASSWORD=your-test-password